import logging 
logging.basicConfig(
    filename="sistema_errores.log",
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s",
    encoding="utf-8")

class ServicioError(Exception):
    """Excepción base para errores en el módulo de servicios."""
    pass

class ParametroInvalidoError(ServicioError):
    """Se lanza cuando los días, horas o valores son negativos o inválidos."""
    pass

from abc import ABC 
class Servicio(ABC):
    def __init__(self, nombre: str, precio_base: float):
        if precio_base < 0:
            raise ParametroInvalidoError("El precio base no puede ser negativo.")
        self._nombre = nombre         
        #Atributo protegido / encapsulado
        self._precio_base = precio_base

    def nombre(self):
        return self._nombre

    def calcular_costo(self, *args, **kwargs) -> float:
        """Método abstracto para implementar Polimorfismo."""
        pass
        
    def obtener_descripcion(self) -> str:
        """Método abstracto para describir el servicio."""
        pass

class ReservaSala(Servicio):
    def __init__(self, precio_base: float, capacidad: int):
        super().__init__("Reserva de Sala", precio_base)
        self.capacidad = capacidad

    def calcular_costo(self, horas: int, impuesto: float = 0.19) -> float:
        """Cálculo de costo con variante de impuesto opcional."""
        if horas <= 0:
            raise ParametroInvalidoError("Las horas de reserva deben ser mayores a cero.")
        
        costo_total = self._precio_base * horas
        return costo_total + (costo_total * impuesto)

    def obtener_descripcion(self) -> str:
        return f"Servicio: {self.nombre} (Capacidad: {self.capacidad} personas)."

class AlquilerEquipo(Servicio):
    def __init__(self, precio_base: float, tipo_equipo: str):
        super().__init__("Alquiler de Equipos", precio_base)
        self.tipo_equipo = tipo_equipo

    def calcular_costo(self, dias: int, descuento: float = 0.0) -> float:
        """Cálculo de costo con variante de descuento opcional."""
        if dias <= 0:
            raise ParametroInvalidoError("Los días de alquiler deben ser mayores a cero.")
        if not (0.0 <= descuento <= 1.0):
            raise ParametroInvalidoError("El descuento debe ser un porcentaje decimal entre 0 y 1.")
        
        costo_total = self._precio_base * dias
        return costo_total - (costo_total * descuento)

    def obtener_descripcion(self) -> str:
        return f"Servicio: {self.nombre} (Equipo: {self.tipo_equipo})."
import tkinter as tk
from tkinter import messagebox 
    
    # Crear la ventana base

# 1. Crear la ventana base
ventana = tk.Tk()
ventana.title("Sistema de Gestión de Servicios")
ventana.geometry("400x400") 
# Esto define el tamaño de la ventana 

# 2. Crear los elementos visuales (Campos de texto)
tk.Label(ventana, text="Precio Base ($):").pack(pady=5)
entrada_precio = tk.Entry(ventana)
entrada_precio.pack()

tk.Label(ventana, text="Tiempo (Horas o Días):").pack(pady=5)
entrada_tiempo = tk.Entry(ventana)
entrada_tiempo.pack()

tk.Label(ventana, text="Capacidad (Solo para Sala):").pack(pady=5)
entrada_capacidad = tk.Entry(ventana)
entrada_capacidad.pack()

def procesar_formulario():
    try:
        # Tomamos los datos que el usuario escribió en las cajitas visuales
        precio = float(entrada_precio.get())
        horas = int(entrada_tiempo.get())
        capacidad = int(entrada_capacidad.get())
        
        # INSTANCIAMOS TU CLASE (La que creaste en las fotos anteriores)
        servicio = ReservaSala(precio_base=precio, capacidad=capacidad)
        
        # Ejecutamos tus métodos matemáticos
        costo_final = servicio.calcular_costo(horas=horas)
       
       # Mostramos el resultado final en la etiqueta de la ventana
        label_resultado.config(text=f"{descripcion}\nCosto Total: ${costo_final:.2f}", fg="green") 
    except ValueError:
        # Si el usuario escribe letras en vez de números
     messagebox.showerror("Error de datos", "Por favor, ingresa solo números válidos.")
        
    except ParametroInvalidoError as e:
        # AQUÍ CAPTURAS TU PROPIA EXCEPCIÓN (Si ponen números negativos)
     label_resultado.config(text=f"Error: {e}", fg="red") 

# 3. Crear el botón que ejecuta la función
boton_calcular = tk.Button(ventana, text="Calcular Servicio", command=procesar_formulario)
boton_calcular.pack(pady=20)

# Etiqueta invisible abajo que se usará para mostrar el resultado final
label_resultado = tk.Label(ventana, text="", font=("Arial", 11, "bold"))
label_resultado.pack(pady=10)

# 4. Mantener la ventana abierta esperando los clics del usuario
ventana.mainloop()
