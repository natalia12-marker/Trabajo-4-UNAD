import json
from config.configuracion import (
    DATA_DIR,
    ASSETS_DIR,
    CONFIG_DIR,
    MODELS_DIR,
    VIEWS_DIR,
    CONTROLLERS_DIR,
    UTILS_DIR,
    CLIENTES_FILE,
    SERVICIOS_FILE,
    RESERVAS_FILE,
    LOG_FILE,
)

class Almacenamiento:
    """
    Gestiona todas las operaciones relacionadas con los archivos
    utilizados por el sistema.
    """

    @staticmethod
    def crear_estructura():
        """
        Crea automáticamente la estructura mínima del proyecto si no existe.
        Sustituye la inicialización directa en configuración para evitar ciclos.
        """
        # Lista de todas las carpetas necesarias en la raíz del proyecto
        carpetas = [
            DATA_DIR, ASSETS_DIR, CONFIG_DIR, 
            MODELS_DIR, VIEWS_DIR, CONTROLLERS_DIR, UTILS_DIR
        ]
        
        for carpeta in carpetas:
            carpeta.mkdir(parents=True, exist_ok=True)
        
        # Archivos de datos que deben inicializarse como listas JSON vacías
        archivos_json = [CLIENTES_FILE, SERVICIOS_FILE, RESERVAS_FILE]

        for archivo in archivos_json:
            # Corrección: Validar la existencia de cada archivo individual usando .exists()
            if not archivo.exists():
                with open(archivo, "w", encoding="utf-8") as f:
                    json.dump([], f, indent=4)

        # Crear archivo de logs vacío si no existe
        if not LOG_FILE.exists():
            LOG_FILE.touch()

    @staticmethod
    def cargar_json(ruta):
        """
        Lee un archivo JSON y devuelve su contenido. Si el archivo no existe
        o está corrupto, retorna una lista vacía.
        """
        if not ruta.exists():
            return []
        
        try:
            with open(ruta, "r", encoding="utf-8") as archivo:
                return json.load(archivo)
        except json.JSONDecodeError:
            # Previene caídas del sistema si el archivo JSON se edita mal a mano
            return []
        
    @staticmethod
    def guardar_json(ruta, datos):
        """
        Guarda los datos proporcionados en un archivo JSON estructurado.
        """
        with open(ruta, "w", encoding="utf-8") as archivo:
            json.dump(
                datos,
                archivo,
                indent=4,
                ensure_ascii=False  # Permite guardar tildes y eñes de forma nativa
            )
