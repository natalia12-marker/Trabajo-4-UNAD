from utils.validaciones import Validaciones


class Servicio:
    """
    Representa un servicio ofrecido por la empresa dentro del sistema integral.
    """

    def __init__(self, codigo, nombre, precio, duracion):
        """
        Inicializa un servicio ejecutando filtros estrictos de control de datos.
        """
        if Validaciones.campo_vacio(codigo):
            raise ValueError("El código no puede estar vacío.")

        if Validaciones.campo_vacio(nombre):
            raise ValueError("El nombre no puede estar vacío.")

        if precio <= 0:
            raise ValueError("El precio debe ser mayor que cero.")

        if duracion <= 0:
            raise ValueError("La duración debe ser mayor que cero.")

        self._codigo = codigo
        self._nombre = nombre
        self._precio = precio
        self._duracion = duracion

    @property
    def codigo(self):
        """Devuelve el código identificador único del servicio (Solo lectura)."""
        return self._codigo

    @property
    def nombre(self):
        """Devuelve el nombre descriptivo del servicio."""
        return self._nombre

    @nombre.setter
    def nombre(self, nuevo_nombre):
        """Modifica el nombre asegurando que no contenga una cadena vacía."""
        if Validaciones.campo_vacio(nuevo_nombre):
            raise ValueError("El nombre no puede estar vacío.")
        self._nombre = nuevo_nombre

    @property
    def precio(self):
        """Devuelve el valor comercial asignado al servicio."""
        return self._precio

    @precio.setter
    def precio(self, nuevo_precio):
        """Modifica el precio verificando que sea un valor financiero positivo."""
        if nuevo_precio <= 0:
            raise ValueError("El precio debe ser mayor que cero.")
        self._precio = nuevo_precio

    @property
    def duracion(self):
        """Devuelve la extensión de tiempo estimada del servicio en minutos."""
        return self._duracion

    @duracion.setter
    def duracion(self, nueva_duracion):
        """Modifica la duración verificando que sea un intervalo de tiempo válido."""
        if nueva_duracion <= 0:
            raise ValueError("La duración debe ser mayor que cero.")
        self._duracion = nueva_duracion

    def __str__(self):
        """
        Devuelve una ficha técnica en texto con los atributos del servicio formateados.
        """
        return (
            f"Código: {self.codigo}\n"
            f"Nombre: {self.nombre}\n"
            f"Precio: ${self.precio:.2f}\n"
            f"Duración: {self.duracion} minutos"
