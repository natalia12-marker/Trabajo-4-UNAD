"""

class SistemaError(Exception):
    """
    Excepción base de todo el sistema integral.
    """

    def __init__(self, mensaje, operacion=None):
        """
        Inicializa la excepción almacenando la descripción y el contexto operativo.
        """
        self.mensaje = mensaje
        self.operacion = operacion
        super().__init__(mensaje)

    def __str__(self):
        """Formatea el error incluyendo la operación si está disponible."""
        if self.operacion:
            return f"[{self.operacion}] Error: {self.mensaje}"
        return self.mensaje



# EXCEPCIONES DE CLIENTES

class ClienteError(SistemaError):
    """Excepción base para todos los errores relacionados con clientes."""
    pass

class ClienteNoEncontradoError(ClienteError):
    """Se produce cuando se busca una cédula que no existe en el sistema."""
    pass

class ClienteDuplicadoError(ClienteError):
    """Se produce cuando se intenta registrar un cliente cuya cédula ya existe."""
    pass

class CorreoInvalidoError(ClienteError):
    """Se produce cuando el correo electrónico tiene un formato inválido."""
    pass

class TelefonoInvalidoError(ClienteError):
    """Se produce cuando el teléfono contiene caracteres inválidos."""
    pass

class CedulaInvalidaError(ClienteError):
    """Se produce cuando el documento de identidad no cumple el patrón numérico."""
    pass


# EXCEPCIONES DE SERVICIOS

class ServicioError(SistemaError):
    """Excepción base para los errores relacionados con servicios."""
    pass

class ServicioNoEncontradoError(ServicioError):
    """Se produce al buscar un código de servicio inexistente."""
    pass

class ServicioDuplicadoError(ServicioError):
    """Se produce si el código identificador del servicio ya fue registrado."""
    pass

class DuracionInvalidaError(ServicioError):
    """Se produce si la duración del servicio es menor o igual a cero (Corregido de sección)."""
    pass

class PrecioInvalidoError(ServicioError):
    """Se produce si el valor monetario asignado al servicio es menor o igual a cero."""
    pass


# EXCEPCIONES DE RESERVAS

class ReservaError(SistemaError):
    """Excepción base para los errores relacionados con las reservas."""
    pass

class ReservaNoEncontradaError(ReservaError):
    """Se produce al buscar un código de reserva inexistente."""
    pass

class ReservaDuplicadaError(ReservaError):
